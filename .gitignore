venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.env
.env.*

# ---------------------------------------------------------------
# Build output (generated by build_exe.bat / PyInstaller)
# ---------------------------------------------------------------
build/
dist/
*.manifest
*.spec
!UDM.spec
# ffmpeg / ffprobe / deno downloaded at build time
vendor/
# generated by tools/make_icon.py
udm.ico

# Archives. Release builds in "Software Builds/" are intentionally tracked.
extension.zip
*.zip
Software Builds/*.zip
Software Builds/*.exe
*.exe

