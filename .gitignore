# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

